# Keep upload payload small and avoid Vercel's 100 MB per-file limit
# (the .git packfile alone is >100 MB).

.git
.github
.venv
.euroeval_cache
.scandeval_cache
.pytest_cache
.ruff_cache
.mypy_cache
node_modules

# Local maintainer artifacts (large, never needed at runtime).
results.tar.gz
new_results.jsonl
ucloud*_results.jsonl
*outputs.json

# Keep build-time source inputs available for Vercel Git builds.
# Vite imports build plugins, which read the frontend and Python sources.
# The directories below are not needed by the deployed site itself.
tests
docs
site
__pycache__

# Dotfiles & misc
.env*
.vercel
.DS_Store
*.log
