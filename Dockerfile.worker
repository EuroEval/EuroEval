# syntax=docker/dockerfile:1.7

# The pinned CUDA manifest is multi-arch (linux/amd64 and linux/arm64). BuildKit
# selects the target child; NVIDIA Container Toolkit supplies the host driver at run time.
# Keep the builder toolchain separate from the runtime image.
FROM ghcr.io/astral-sh/uv:0.8.22@sha256:9874eb7afe5ca16c363fe80b294fe700e460df29a55532bbfea234a0f12eddb1 AS uv
FROM nvidia/cuda:13.1.1-base-ubuntu24.04@sha256:e8c8679ccd042249d4c4080a3fab5a6bb52ab6e771addffa2e6e4eafea797bd2 AS build

ENV DEBIAN_FRONTEND=noninteractive \
    UV_PROJECT_ENVIRONMENT=/opt/euroeval/.venv \
    UV_CACHE_DIR=/cache/uv \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    PATH=/opt/euroeval/.venv/bin:$PATH

COPY --from=uv /uv /uvx /bin/

RUN apt-get update && \
    apt-get install --no-install-recommends -y \
      ca-certificates \
      gcc \
      git \
      python3.12 \
      python3.12-venv && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /opt/euroeval

# Resolve the locked dependency set before copying source so source-only changes
# reuse the expensive dependency layer. The generative extra supplies vLLM.
COPY pyproject.toml uv.lock README.md LICENSE ./
RUN --mount=type=cache,target=/cache/uv,sharing=locked \
    uv sync --frozen --no-dev --extra generative --python /usr/bin/python3.12 \
      --no-install-project

COPY src/euroeval ./src/euroeval
COPY src/euroeval_worker ./src/euroeval_worker
RUN --mount=type=cache,target=/cache/uv,sharing=locked \
    uv sync --frozen --no-dev --extra generative --python /usr/bin/python3.12

# EuroEval checks for nvcc before loading generative CUDA models. Keep Git, uv,
# and the build cache out of the runtime image while retaining the CUDA toolchain.
FROM nvidia/cuda:13.1.1-devel-ubuntu24.04@sha256:9cf8694a27722418a1f175d90f85d5afb5a728fd4a9907d7f0565efecfa14d32

ENV DEBIAN_FRONTEND=noninteractive \
    HF_HOME=/cache/huggingface \
    HF_HUB_CACHE=/cache/huggingface/hub \
    HF_DATASETS_CACHE=/cache/huggingface/datasets \
    TRANSFORMERS_CACHE=/cache/huggingface/transformers \
    XDG_CACHE_HOME=/cache/xdg \
    XDG_CONFIG_HOME=/cache/config \
    FLASHINFER_WORKSPACE_BASE=/cache/flashinfer \
    VLLM_CACHE_ROOT=/cache/vllm/cache \
    VLLM_CONFIG_ROOT=/cache/vllm/config \
    VLLM_NO_USAGE_STATS=1 \
    TRITON_CACHE_DIR=/cache/triton \
    TORCHINDUCTOR_CACHE_DIR=/cache/torch/inductor \
    TORCH_EXTENSIONS_DIR=/cache/torch/extensions \
    CUDA_CACHE_PATH=/cache/nvidia \
    HOME=/home/worker \
    PATH=/opt/euroeval/.venv/bin:/usr/local/cuda/bin:$PATH

RUN apt-get update && \
    apt-get install --no-install-recommends -y \
      ca-certificates \
      python3.12 \
      python3.12-dev && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /opt/euroeval
COPY --from=build /opt/euroeval/.venv ./.venv
COPY --from=build /opt/euroeval/src/euroeval ./src/euroeval
COPY --from=build /opt/euroeval/src/euroeval_worker ./src/euroeval_worker

RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin worker && \
    mkdir -p /cache && \
    chown -R worker:worker /cache /home/worker

USER worker

ENTRYPOINT ["euroeval-worker"]
CMD []
